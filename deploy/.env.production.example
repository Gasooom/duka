# ---------------------------------------------------------------------------
# Duka PRODUCTION (or STAGING) configuration. Copy to deploy/.env.production
# (staging: deploy/.env.staging) and fill in. Never commit the real file.
# Keep comments on their own lines (docker compose treats "VALUE  # x" as part of the value).
# The app refuses to start in production if a required value is missing or weak.
# Generate secrets on the server:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"          (JWT, tokens)
#   python3 -c "import secrets;print(secrets.token_hex(24))"              (database password: URL-safe)
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#   (or: docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c '...'")
# ---------------------------------------------------------------------------

# Public domain that points (DNS A record) to this server; HTTPS is automatic.
DUKA_DOMAIN=duka.example.rw
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.rw

# Database (only reachable inside the server's Docker network).
POSTGRES_USER=duka
POSTGRES_PASSWORD=
POSTGRES_DB=duka

# Auth and encryption
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
ENCRYPTION_KEY=

# AI language model (OpenAI-compatible). Verify with: docker compose ... exec backend python -m app.cli llm-check
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Further models a business may choose (comma-separated); LLM_MODEL is always allowed.
LLM_ALLOWED_MODELS=
AGENT_TURN_TIMEOUT_SECONDS=45
# Runaway Conversation Guard (docs/OPERATIONS.md > Runaway Conversation Guard). The per-message budget enforces by
# default. Customer and tenant limits start in observe mode with no limit: choose them from observe-mode data
# (docs/EXTERNAL_VALIDATION.md, section 5), then set the *_MODE to enforce.
AI_GUARD_MESSAGE_MODE=enforce
AI_GUARD_CUSTOMER_MODE=observe
AI_GUARD_TENANT_MODE=observe
AI_GUARD_CUSTOMER_CALLS_PER_HOUR=0
AI_GUARD_CUSTOMER_CALLS_PER_DAY=0
AI_GUARD_TENANT_CALLS_PER_HOUR=0
AI_GUARD_TENANT_CALLS_PER_DAY=0
AI_GUARD_TENANT_OVERRIDES=

# Embeddings: hash (free, lexical) or openai_compat (semantic, needs a key)
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# WhatsApp Cloud API (one Meta app for the platform). Webhook URL: https://<DUKA_DOMAIN>/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_FORCE_DEV=false

# Operations: bearer token for /metrics and /readyz?details=1
OPS_TOKEN=
LOG_LEVEL=INFO
BACKGROUND_WORKERS=2
WEBHOOK_EVENT_RETENTION_DAYS=30
# Owner reminders (once per order) for orders holding stock: pending review / accepted but unpaid this many hours.
ORDER_REVIEW_REMINDER_HOURS=2
ORDER_PAYMENT_REMINDER_HOURS=24

# Payments: manual payments need nothing here. MTN MoMo Collections is not enabled for the MVP.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=

# Always off in production regardless of these values (kept explicit).
ENABLE_DEV_TOOLS=false
ALLOW_PUBLIC_REGISTRATION=false
