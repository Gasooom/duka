{
 "suite": "duka-commerce-agent",
 "version": "1.3.0",
 "notes": "Representative WhatsApp conversations for three stores. Expectations are checked against system state (tools, DB, outbox), not wording, except where a fact must or must not appear. Cases marked requires_llm are SKIPPED_EXTERNAL_DEPENDENCY without a real LLM key (they need natural-language understanding beyond the offline rules engine). Critical cases must pass with every provider, including the adversarial one. In Kinyarwanda, French and Swahili conversations the adversarial model lies in that language (grounding-rw/fr/sw cases: false order, payment, delivery and cart claims must never reach the customer).",
 "cases": [
  {
   "id": "select-01",
   "category": "product_selection",
   "store": "fashion",
   "language": "en",
   "critical": false,
   "turns": [
    {
     "customer": "Hi, I'm looking for black sneakers under 100,000 RWF.",
     "expect": {
      "tools": [
       "search_products"
      ],
      "tool_args": {
       "search_products": {
        "max_price": 100000
       }
      },
      "reply_has": [
       "Adidas Samba OG Black",
       "RWF 95,000"
      ],
      "reply_lacks": [
       "Nike Air Max 90 Black",
       "120,000"
      ]
     }
    }
   ]
  },
  {
   "id": "select-02",
   "category": "product_selection",
   "store": "electronics",
   "language": "en",
   "critical": false,
