# ---------------------------------------------------------------------------
# Duka — copy to .env and fill in. NEVER commit .env.
# Values marked (CREDENTIAL) are external secrets; the app runs without them
# in development using the rules agent, hash embeddings, dev WhatsApp adapter
# and mock payments.
# Keep comments on their own lines: docker compose's env_file treats a trailing
# "# comment" after an empty value as the value itself (the app refuses to start then).
# ---------------------------------------------------------------------------
# development | production
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Database (docker compose overrides host to `db`)
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# Auth & crypto — generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Fernet key for encrypting tenant WhatsApp tokens at rest (REQUIRED in production)
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AI / LLM ------------------------------------------------------------------
# rules         = deterministic offline engine (no cost, English commerce phrasing only)
# openai_compat = any OpenAI-compatible chat API with tool calling (CREDENTIAL)
LLM_PROVIDER=rules
LLM_BASE_URL=https://api.openai.com/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai   Groq: https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Further models a business may choose under "Business & AI" (comma-separated). LLM_MODEL is always allowed;
# anything else is refused when saved.
LLM_ALLOWED_MODELS=
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_HISTORY_MESSAGES=8
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_SUMMARY_TRIGGER_MESSAGES=24
# Usage metering: path to the operator's price list for AI calls and WhatsApp messages (JSON; format in
# docs/OPERATIONS.md > Usage metering). Every real AI call and all WhatsApp traffic is recorded in usage_events
# either way; without this file (or for what it does not list) it is recorded unpriced.
# Duka ships no prices. A file that is not a valid price list stops the backend from starting.
USAGE_PRICING_FILE=

# Embeddings (vector dim fixed at 384 by migration 0001)
# hash (free, offline) | openai_compat (CREDENTIAL)
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- WhatsApp Cloud API ----------------------------------------------------------
# Per-business phone_number_id + access token are entered in the dashboard (/dashboard/whatsapp)
# and stored encrypted. These two are platform-level (one Meta app):
# you type the same value in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
# (CREDENTIAL) Meta App > Settings > Basic > App secret
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# true = never call Meta, route all outbound through the dev adapter
WHATSAPP_FORCE_DEV=false
# WhatsApp delivers normal messages only within 24 h of the customer's last message. Older than this (hours), a
# message to the customer is not attempted and the owner is alerted instead (the margin covers processing delays).
WHATSAPP_WINDOW_HOURS=23.5
# Owner reminders (once per order) for orders holding stock: pending review / accepted but unpaid this many hours.
# 0 = off.
ORDER_REVIEW_REMINDER_HOURS=2
ORDER_PAYMENT_REMINDER_HOURS=24

# --- Payments ------------------------------------------------------------------
# HMAC for the mock provider callback
PAYMENT_WEBHOOK_SECRET=change-me-mock-callback-secret
# MTN MoMo Collection API (CREDENTIAL) — https://momodeveloper.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# production: mtnrwanda (or your market)
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# public https URL of this backend, e.g. https://api.example.com
MOMO_CALLBACK_HOST=
# sandbox only accepts EUR
MOMO_CURRENCY_OVERRIDE=

# WhatsApp simulator + payment simulation; forced off in production
ENABLE_DEV_TOOLS=true
# self-service signup; always closed when APP_ENV=production (use `python -m app.cli create-business`)
ALLOW_PUBLIC_REGISTRATION=true

# --- Hardening -----------------------------------------------------------------
# Reverse proxies in front of the API that append to X-Forwarded-For: 0 locally, 1 on Render and behind
# deploy/Caddyfile. Rate limits use the address that proxy saw; what a client writes in the header is ignored.
TRUSTED_PROXY_HOPS=0
