# ---------------------------------------------------------------------------
# Duka — copy to .env and fill in. NEVER commit .env.
# Values marked (CREDENTIAL) are external secrets; the app runs without them
# in development using the rules agent, hash embeddings, dev WhatsApp adapter
# and mock payments.
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Database (docker compose overrides host to `db`)
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# Auth & crypto — generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Fernet key for encrypting tenant WhatsApp tokens at rest (REQUIRED in production)
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AI / LLM ------------------------------------------------------------------
# rules         = deterministic offline engine (no cost, English commerce phrasing only)
# openai_compat = any OpenAI-compatible chat API with tool calling (CREDENTIAL)
LLM_PROVIDER=rules
LLM_BASE_URL=https://api.openai.com/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai   Groq: https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_HISTORY_MESSAGES=8
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_SUMMARY_TRIGGER_MESSAGES=24

# Embeddings (vector dim fixed at 384 by migration 0001)
EMBEDDING_PROVIDER=hash             # hash (free, offline) | openai_compat (CREDENTIAL)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- WhatsApp Cloud API ----------------------------------------------------------
# Per-business phone_number_id + access token are entered in the dashboard (/dashboard/whatsapp)
# and stored encrypted. These two are platform-level (one Meta app):
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token   # you type the same value in Meta's webhook config
WHATSAPP_APP_SECRET=                                 # (CREDENTIAL) Meta App > Settings > Basic > App secret
WHATSAPP_API_VERSION=v21.0
WHATSAPP_FORCE_DEV=false            # true = never call Meta, route all outbound through the dev adapter

# --- Payments ------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=change-me-mock-callback-secret   # HMAC for the mock provider callback
# MTN MoMo Collection API (CREDENTIAL) — https://momodeveloper.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox     # production: mtnrwanda (or your market)
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_HOST=                 # public https URL of this backend, e.g. https://api.example.com
MOMO_CURRENCY_OVERRIDE=             # sandbox only accepts EUR

ENABLE_DEV_TOOLS=true               # WhatsApp simulator + payment simulation; forced off in production
